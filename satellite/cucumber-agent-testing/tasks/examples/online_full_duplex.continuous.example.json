{
  "schema": "polaris.online-full-duplex.task.v1",
  "task_id": "online_full_duplex.continuous",
  "description": "在线全双工 FD-002/FD-003：首次唤醒后连续在线语句，验证会话保持、连续 ASR 和连续响应。",
  "validation_pack": {
    "pack": "docs/wiki/voice-validation/packs/online-full-duplex.md",
    "case_ids": [
      "FD-002",
      "FD-003"
    ],
    "linked_tag": "full_duplex_recognition"
  },
  "scenario": {
    "tag": "full_duplex_recognition"
  },
  "runner": {
    "mode": "dry-run",
    "compile_first": true,
    "strict_compile": true,
    "feature": "satellite/cucumber-agent-testing/features/polaris_voice_core.feature",
    "mapping": "satellite/cucumber-agent-testing/references/voice_core_mapping.json"
  },
  "environment": {
    "env_file": "polaris.local.json"
  },
  "inputs": {
    "command_text": "太阳为什么会发光"
  },
  "execution": {
    "observe_ms": 45000,
    "full_duplex_timeout_s": 60,
    "half_duplex_timeout_s": 15,
    "timing_guard_ms": 1200,
    "manage_session": true,
    "runtime_strict": true,
    "allow_side_effects": false,
    "adapter_flows": {
      "pre": [
        {
          "flow": "laid_check",
          "when": "always",
          "required": false
        },
        {
          "flow": "switch_device_env",
          "when": "always",
          "required": true
        },
        {
          "flow": "ensure_online",
          "when": "always",
          "required": false
        },
        {
          "flow": "set_full_duplex",
          "when": "always",
          "required": true,
          "params": {
            "full_duplex_timeout_s": "{full_duplex_timeout_s}"
          }
        }
      ],
      "post": [
        {
          "flow": "set_half_duplex",
          "when": "always",
          "required": false,
          "execute": false,
          "params": {
            "half_duplex_timeout_s": "{half_duplex_timeout_s}"
          }
        }
      ]
    },
    "command_sequence": [
      "今天天气怎么样",
      "太阳为什么会发光",
      "长城有多长"
    ],
    "max_continuous_utterances": 3
  },
  "expected": {
    "summary": "全双工配置生效后，唤醒、在线 ASR/命令、TTS/media 响应和无 reboot/crash 证据需要同时满足；环境、声卡、网络、云端配置问题优先 BLOCKED。",
    "key_assertions": [
      "cloud_full_duplex_apply == success",
      "wake_before_command observed",
      "command_asr_or_keyword observed",
      "successful_response_count >= 1",
      "no_reboot_in_duplex_recognition",
      "no_crash_in_duplex_recognition"
    ],
    "failure_attribution": [
      "设备未在线、API 环境不一致、声卡/PA 不可用、串口日志缺失先判 BLOCKED。",
      "唤醒成功且配置生效但无 ASR/响应，进入固件/ASR/云端/媒体链路归因。",
      "超时或播报临界区无法确认有效注入时，标记 TIMING_AMBIGUOUS。"
    ]
  },
  "command_examples": {
    "precheck": "python satellite/cucumber-agent-testing/scripts/run_optimized_task.py --task satellite/cucumber-agent-testing/tasks/examples/online_full_duplex.continuous.example.json --precheck-only",
    "dry_run": "python satellite/cucumber-agent-testing/scripts/run_optimized_task.py --task satellite/cucumber-agent-testing/tasks/examples/online_full_duplex.continuous.example.json --mode dry-run",
    "execute": "python satellite/cucumber-agent-testing/scripts/run_optimized_task.py --task satellite/cucumber-agent-testing/tasks/examples/online_full_duplex.continuous.example.json --mode execute --allow-side-effects --manage-session --runtime-strict"
  }
}
