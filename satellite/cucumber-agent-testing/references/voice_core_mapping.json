{
  "framework": {
    "name": "Polaris Cucumber Agent Testing",
    "mode": "BDD + Agent Testing",
    "debug_root": "satellite/cucumber-agent-testing/debug",
    "note": "默认 plan-only 不占用串口、不播放音频、不调用云端。"
  },
  "defaults": {
    "wake_word": "小美小美",
    "command_text": "打开空调",
    "command_file": "docs/fa2命令词.txt",
    "device_key": "",
    "wifi_ssid": "",
    "wifi_password": "",
    "observe_ms": "15000",
    "command_limit": "20"
  },
  "scenarios": {
    "first_wake": {
      "title": "首次唤醒",
      "source_test_item": "唤醒/首次唤醒",
      "validation_module": "wake-session",
      "agent_goal": "验证待唤醒状态下播放唤醒词后，CP/AP/ASR 日志出现唤醒闭环。",
      "preconditions": [
        "串口 logger 已启动且 CP/ASR/AP 日志可读。",
        "播放声卡可用，DUT 能听到播放音频。",
        "设备当前不在识别模式或上一轮会话已退出。"
      ],
      "commands": [
        {
          "name": "phrase_probe_first_wake",
          "cmd": [
            "{python}",
            "tools/probe/polaris_phrase_probe.py",
            "--text",
            "{wake_word}",
            "--observe-ms",
            "{observe_ms}",
            "--label",
            "bdd_first_wake",
            "--device-key",
            "{device_key}"
          ]
        }
      ],
      "assertions": [
        {
          "name": "playback_returncode",
          "expected": "0",
          "owner": "audio/playback"
        },
        {
          "name": "cp_wake_count",
          "expected": ">=1",
          "owner": "firmware-or-device"
        },
        {
          "name": "ap_wake_count",
          "expected": ">=1",
          "owner": "firmware-or-device"
        },
        {
          "name": "asr_wake_count",
          "expected": ">=1",
          "owner": "asr-device"
        }
      ],
      "failure_split": [
        "播放失败或目标声卡不存在：测试环境/设备连接问题。",
        "串口日志缺失：测试环境或 logger 问题。",
        "播放成功但无任何唤醒证据：音频链路、麦克风链路或固件唤醒问题。",
        "只有部分端口有证据：按 CP/AP/ASR 缺失位置定位模块问题。"
      ]
    },
    "recognition_mode_wake": {
      "title": "识别模式下唤醒",
      "source_test_item": "唤醒/识别模式唤醒",
      "validation_module": "wake-session",
      "agent_goal": "验证设备已进入识别模式后，在识别超时窗口内再次播放唤醒词仍能被正确处理。",
      "preconditions": [
        "先通过首次唤醒让设备进入识别模式。",
        "第二次唤醒必须避开识别超时边界，否则标记 TIMING_AMBIGUOUS。",
        "使用固定 wake_stress runner 记录前置唤醒、目标唤醒和窗口证据。"
      ],
      "commands": [
        {
          "name": "wake_stress_recognition_mode_smoke",
          "cmd": [
            "{python}",
            "satellite/cucumber-agent-testing/scripts/run_wake_stress.py",
            "--wake-word",
            "{wake_word}",
            "--device-key",
            "{device_key}",
            "--max-first-rounds",
            "1",
            "--max-recognition-rounds",
            "1",
            "--recognition-intervals",
            "2",
            "--precondition-observe-s",
            "8",
            "--target-observe-s",
            "8",
            "--idle-wait-s",
            "2",
            "--run-dir",
            "{debug_dir}/recognition_mode_wake_stress"
          ]
        }
      ],
      "assertions": [
        {
          "name": "first_wake_success",
          "expected": "true",
          "owner": "precondition"
        },
        {
          "name": "recognition_window_second_wake",
          "expected": "observed",
          "owner": "firmware-or-requirement"
        },
        {
          "name": "session_timeout_boundary",
          "expected": "not expired before second wake",
          "owner": "test-design"
        }
      ],
      "failure_split": [
        "第一次唤醒失败：不能归为识别模式唤醒失败，应先归因首次唤醒或音频链路。",
        "第二次播放超出识别超时窗口：测试设计/执行问题。",
        "窗口内播放成功但不唤醒：固件行为或需求定义需确认。"
      ]
    },
    "half_duplex_recognition": {
      "title": "半双工识别",
      "source_test_item": "在线识别/半双工识别",
      "validation_module": "duplex-mode",
      "agent_goal": "验证半双工模式下唤醒后命令词识别、播报中输入抑制和播报后恢复符合需求。",
      "preconditions": [
        "设备在线，云端控制链路可用。",
        "自然对话/全双工开关已切到半双工口径。",
        "需要区分命令识别窗口和播报窗口。"
      ],
      "commands": [
        {
          "name": "ensure_online_before_half_duplex",
          "cmd": [
            "{python}",
            "tools/device/polaris_network_orchestrator.py",
            "ensure-online",
            "--ssid",
            "{wifi_ssid}",
            "--pwd",
            "{wifi_password}",
            "--label",
            "bdd_ensure_online_half_duplex"
          ]
        },
        {
          "name": "doc_case_half_duplex_1s_command",
          "cmd": [
            "{python}",
            "tools/execution/polaris_doc_case_runner.py",
            "--case-id",
            "美的空调_23",
            "--device-key",
            "{device_key}"
          ]
        }
      ],
      "assertions": [
        {
          "name": "cloud_half_duplex_apply",
          "expected": "success",
          "owner": "cloud-or-config"
        },
        {
          "name": "wake_before_command",
          "expected": "observed",
          "owner": "precondition"
        },
        {
          "name": "command_asr_or_keyword",
          "expected": "observed",
          "owner": "firmware-or-device"
        },
        {
          "name": "playback_window_policy",
          "expected": "no forbidden recognition during half-duplex playback",
          "owner": "requirement"
        }
      ],
      "failure_split": [
        "云端配置未生效：云端/网络/配置问题。",
        "未唤醒导致无 ASR：前置唤醒问题。",
        "唤醒成功但命令未进 ASR：固件/设备识别问题。",
        "播报中输入是否应响应不清晰：需求问题。"
      ]
    },
    "full_duplex_recognition": {
      "title": "全双工识别",
      "source_test_item": "在线识别/全双工识别",
      "validation_module": "duplex-mode",
      "agent_goal": "验证全双工模式下连续命令、播报中识别或打断能力符合需求。",
      "preconditions": [
        "设备在线，云端控制链路可用。",
        "自然对话/全双工开关已切到全双工口径。",
        "播报中识别、打断、连续对话三者必须按需求定义区分。"
      ],
      "commands": [
        {
          "name": "ensure_online_before_full_duplex",
          "cmd": [
            "{python}",
            "tools/device/polaris_network_orchestrator.py",
            "ensure-online",
            "--ssid",
            "{wifi_ssid}",
            "--pwd",
            "{wifi_password}",
            "--label",
            "bdd_ensure_online_full_duplex"
          ]
        },
        {
          "name": "doc_case_full_duplex_1s_command",
          "cmd": [
            "{python}",
            "tools/execution/polaris_doc_case_runner.py",
            "--case-id",
            "美的空调_26",
            "--device-key",
            "{device_key}"
          ]
        }
      ],
      "assertions": [
        {
          "name": "cloud_full_duplex_apply",
          "expected": "success",
          "owner": "cloud-or-config"
        },
        {
          "name": "wake_before_command",
          "expected": "observed",
          "owner": "precondition"
        },
        {
          "name": "command_asr_or_keyword",
          "expected": "observed",
          "owner": "firmware-or-device"
        },
        {
          "name": "duplex_policy",
          "expected": "matches requirement",
          "owner": "requirement"
        }
      ],
      "failure_split": [
        "云端配置未生效：云端/网络/配置问题。",
        "命令闭环缺失但配置已生效：固件/ASR/设备行为问题。",
        "播报中是否允许识别或只允许打断不明确：需求问题。"
      ]
    },
    "basic_command_recognition": {
      "title": "基础命令词识别",
      "source_test_item": "命令词/基础命令词识别率",
      "validation_module": "ac-control-command",
      "agent_goal": "对命令词词表执行先唤醒再命令的基础识别验证，并产出逐条 PASS/FAIL/BLOCKED 证据。",
      "preconditions": [
        "命令词词表存在且编码可读。",
        "每条命令前必须先播放唤醒词。",
        "串口日志窗口能覆盖唤醒、ASR、命令和 TTS/tone 反馈。"
      ],
      "commands": [
        {
          "name": "fa2_basic_command_batch",
          "cmd": [
            "{python}",
            "tools/validation/polaris_fa2_command_batch.py",
            "--command-file",
            "{command_file}",
            "--wake-word",
            "{wake_word}",
            "--device-key",
            "{device_key}",
            "--limit",
            "{command_limit}",
            "--label",
            "bdd_basic_command"
          ]
        }
      ],
      "assertions": [
        {
          "name": "playback_returncode",
          "expected": "0",
          "owner": "audio/playback"
        },
        {
          "name": "cp_wake_count",
          "expected": ">=1 per command",
          "owner": "firmware-or-device"
        },
        {
          "name": "asr_total",
          "expected": ">=1 per command",
          "owner": "asr-device"
        },
        {
          "name": "cp_command_count_or_keyword",
          "expected": ">=1 per command",
          "owner": "firmware-or-device"
        }
      ],
      "failure_split": [
        "词表为空或不可读：测试数据问题。",
        "播放失败：测试环境或声卡问题。",
        "唤醒失败：前置唤醒或音频链路问题。",
        "唤醒成功但命令无 ASR/关键词：固件或 ASR 问题。",
        "识别文本与期望词表不一致：词表/需求/语义映射问题。"
      ]
    },
    "requirement_command_smoke": {
      "title": "需求命令词小样本识别",
      "source_test_item": "命令词/需求文档命令词覆盖 smoke",
      "validation_module": "requirements-command-smoke",
      "agent_goal": "对从需求文档抽取或用户指定的命令词文件执行先唤醒再命令的 Cucumber 小样本验证。",
      "preconditions": [
        "命令文件存在且每行是一条可播放语料。",
        "每条命令前必须先播放唤醒词。",
        "如果 oracle 仍是草案，只能输出探索性 PASS/FAIL 和归因，不能直接作为正式固件结论。"
      ],
      "commands": [
        {
          "name": "fa2_requirement_command_batch",
          "cmd": [
            "{python}",
            "tools/validation/polaris_fa2_command_batch.py",
            "--command-file",
            "{command_file}",
            "--wake-word",
            "{wake_word}",
            "--device-key",
            "{device_key}",
            "--limit",
            "{command_limit}",
            "--label",
            "bdd_requirement_command"
          ]
        }
      ],
      "assertions": [
        {
          "name": "playback_returncode",
          "expected": "0",
          "owner": "audio/playback"
        },
        {
          "name": "wake_evidence",
          "expected": ">=1 per command",
          "owner": "precondition/firmware"
        },
        {
          "name": "command_or_asr_evidence",
          "expected": ">=1 per command",
          "owner": "firmware-or-asr"
        },
        {
          "name": "oracle_status",
          "expected": "formal or exploratory clearly marked",
          "owner": "test-design"
        }
      ],
      "failure_split": [
        "命令文件为空或不可读：测试数据问题。",
        "播放或串口失败：测试环境问题。",
        "唤醒失败：唤醒前置或音频链路问题。",
        "有唤醒但无命令/ASR/TTS：固件或 ASR 问题。",
        "期望口径缺失或文本不一致：需求/oracle 待复核。"
      ]
    },
    "requirement_free_speech_smoke": {
      "title": "需求自由说小样本识别",
      "source_test_item": "自由说/需求文档自由说覆盖 smoke",
      "validation_module": "requirements-free-speech-smoke",
      "agent_goal": "对从需求文档抽取或用户指定的自由说语料执行探索性真机识别验证，并明确 oracle 是否正式。",
      "preconditions": [
        "语料文件存在且每行是一条自由说候选。",
        "每条语料前必须先播放唤醒词。",
        "自由说 intent/slot oracle 未确认前，结论必须标记 exploratory。"
      ],
      "commands": [
        {
          "name": "fa2_requirement_free_speech_batch",
          "cmd": [
            "{python}",
            "tools/validation/polaris_fa2_command_batch.py",
            "--command-file",
            "{command_file}",
            "--wake-word",
            "{wake_word}",
            "--device-key",
            "{device_key}",
            "--limit",
            "{command_limit}",
            "--label",
            "bdd_requirement_free_speech"
          ]
        }
      ],
      "assertions": [
        {
          "name": "playback_returncode",
          "expected": "0",
          "owner": "audio/playback"
        },
        {
          "name": "wake_evidence",
          "expected": ">=1 per utterance",
          "owner": "precondition/firmware"
        },
        {
          "name": "asr_or_intent_evidence",
          "expected": ">=1 per utterance when supported",
          "owner": "firmware-or-asr"
        },
        {
          "name": "exploratory_policy",
          "expected": "no formal FAIL without oracle",
          "owner": "test-design"
        }
      ],
      "failure_split": [
        "语料不可播放或声卡失败：测试环境问题。",
        "未唤醒：前置唤醒或音频链路问题。",
        "自由说无正式 oracle：NEEDS_REVIEW，不直接判固件 FAIL。",
        "正式 oracle 已确认但 ASR/intent 缺失：固件/ASR/语义问题。"
      ]
    },
    "interrupt_prerequisite_measurement": {
      "title": "打断前置自播测量",
      "source_test_item": "打断/自播前置发现与测量",
      "validation_module": "interrupt-prerequisite",
      "agent_goal": "自动触发候选长播报，解析自播/TTS start-end，选出可用于后续唤醒打断或识别打断的稳定前置。",
      "preconditions": [
        "串口 logger 和播放声卡可用。",
        "候选来自 interrupt_prerequisite_candidates.json 或用户指定命令文件。",
        "只有测到稳定 start-end 且时长足够的候选才能进入打断主流程。"
      ],
      "commands": [
        {
          "name": "measure_interrupt_prerequisite",
          "cmd": [
            "{python}",
            "satellite/cucumber-agent-testing/scripts/measure_interrupt_prerequisites.py",
            "--run-batch",
            "--candidate-limit",
            "{command_limit}",
            "--candidate-type",
            "requirements_candidate",
            "--candidate-type",
            "offline_command_candidate",
            "--device-key",
            "{device_key}",
            "--wake-word",
            "{wake_word}",
            "--minimum-duration-ms",
            "2500",
            "--label",
            "bdd_interrupt_prerequisite"
          ]
        }
      ],
      "assertions": [
        {
          "name": "candidate_recognition",
          "expected": "PASS or unusable attribution",
          "owner": "precondition"
        },
        {
          "name": "self_play_start_end_detected",
          "expected": "observed for selected candidate",
          "owner": "serial-evidence"
        },
        {
          "name": "duration_enough_for_injection",
          "expected": ">=2500ms and guard remains",
          "owner": "test-design"
        },
        {
          "name": "selected_prerequisite",
          "expected": "selected or BLOCKED/NEEDS_REVIEW",
          "owner": "test-design"
        }
      ],
      "failure_split": [
        "候选未识别：候选不可用/前置问题，不算打断失败。",
        "无自播 start/end：日志口径或设备播报证据不足，NEEDS_REVIEW。",
        "时长不足：候选不可用。",
        "播放/串口/重启异常：环境或设备稳定性阻塞。",
        "候选可用后打断仍失败：才进入后续打断主流程归因。"
      ]
    },
    "wake_interrupt": {
      "title": "自播中唤醒打断",
      "source_test_item": "打断/唤醒打断",
      "validation_module": "interrupt-wake",
      "agent_goal": "复用已测得的自播前置和注入点，在设备播报中播放唤醒词，验证是否产生新的唤醒证据。",
      "preconditions": [
        "必须先执行 interrupt_prerequisite_measurement 并生成 selected_interrupt_prerequisite.json。",
        "注入点必须落在自播 start/end 之间且留有保护时间。",
        "如果时序没有命中自播窗口，结果应为 TIMING_AMBIGUOUS/BLOCKED。"
      ],
      "commands": [
        {
          "name": "run_wake_interrupt",
          "cmd": [
            "{python}",
            "satellite/cucumber-agent-testing/scripts/run_interrupt_injection.py",
            "--kind",
            "wake",
            "--device-key",
            "{device_key}",
            "--wake-word",
            "{wake_word}",
            "--sync-on-self-play"
          ]
        }
      ],
      "assertions": [
        {
          "name": "selected_prerequisite_exists",
          "expected": "true",
          "owner": "precondition"
        },
        {
          "name": "injection_inside_self_play",
          "expected": "true or TIMING_AMBIGUOUS",
          "owner": "test-design"
        },
        {
          "name": "wake_evidence_after_injection",
          "expected": ">=1 when timing hit",
          "owner": "firmware-or-device"
        },
        {
          "name": "failure_attribution",
          "expected": "timing/environment separated from firmware",
          "owner": "test-design"
        }
      ],
      "failure_split": [
        "缺少 selected_interrupt_prerequisite.json：前置未完成。",
        "注入时间不在自播窗口：时序不明确，不能判固件失败。",
        "播放/串口异常：环境 BLOCKED。",
        "注入命中自播窗口但无唤醒证据：固件/设备打断能力问题。",
        "需求规定自播中不允许唤醒：需求口径问题。"
      ]
    },
    "command_interrupt": {
      "title": "自播中识别打断",
      "source_test_item": "打断/识别打断",
      "validation_module": "interrupt-command",
      "agent_goal": "复用已测得的自播前置和注入点，在设备播报中播放命令词，验证是否产生新的 ASR/命令识别证据。",
      "preconditions": [
        "必须先执行 interrupt_prerequisite_measurement 并生成 selected_interrupt_prerequisite.json。",
        "注入点必须落在自播 start/end 之间且留有保护时间。",
        "如果设备当前模式不允许播报中识别，应归为需求或模式配置口径。"
      ],
      "commands": [
        {
          "name": "run_command_interrupt",
          "cmd": [
            "{python}",
            "satellite/cucumber-agent-testing/scripts/run_interrupt_injection.py",
            "--kind",
            "command",
            "--injection-text",
            "{command_text}",
            "--device-key",
            "{device_key}",
            "--wake-word",
            "{wake_word}",
            "--sync-on-self-play",
            "--timing-advance-ms",
            "0"
          ]
        }
      ],
      "assertions": [
        {
          "name": "selected_prerequisite_exists",
          "expected": "true",
          "owner": "precondition"
        },
        {
          "name": "injection_inside_self_play",
          "expected": "true or TIMING_AMBIGUOUS",
          "owner": "test-design"
        },
        {
          "name": "asr_or_command_after_injection",
          "expected": ">=1 when timing hit and mode supports",
          "owner": "firmware-or-device"
        },
        {
          "name": "mode_policy",
          "expected": "requirement/config separated from firmware",
          "owner": "requirement"
        }
      ],
      "failure_split": [
        "缺少 selected_interrupt_prerequisite.json：前置未完成。",
        "注入时间不在自播窗口：时序不明确，不能判固件失败。",
        "播放/串口异常：环境 BLOCKED。",
