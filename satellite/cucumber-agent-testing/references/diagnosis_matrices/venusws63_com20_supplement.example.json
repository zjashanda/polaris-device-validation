{
  "schema": "polaris.command-control-diagnosis.matrix.v1",
  "description": "WS63 AP COM20 + upper/asr COM17 小规模补验证矩阵。目的不是重跑 343 条，而是验证 AP+upper 串口覆盖、控制链路、TTS 空 URL归因和在线媒体对照。",
  "project_id": "venusws63",
  "serial_coverage_expectation": {
    "full_roles": ["ap", "upper"],
    "minimum_roles": ["ap"],
    "if_upper_missing": "COVERAGE_DEGRADED",
    "if_ap_missing": "BLOCKED"
  },
  "matrix": [
